# smartbot-runner.service.template
#
# BOT-002 PAPER-ONLY RUNNER UNIT
#
# This file is the INSTALLED UNIT after BOT-002 approval (Josh approved
# BOT-002 at 2026-09-10 22:15 UTC). The unit targets `main.py
# --continuous` (NOT `scripts/run_continuous.py`) because `main.py`:
#   - Acquires the /tmp/trading_bot.lock single-instance guard so manual
#     and systemd invocations cannot collide.
#   - Defaults loop_delay to None which routes through
#     `SmartTradingBot._resolve_loop_delay(None)` and uses the schema-
#     backed `loop_delay_seconds` value (default 300s).
#   - Provides the same CLI surface for both manual and systemd runs.
#
# The unit is intentionally NOT enabled at install time. Install +
# daemon-reload + a bounded smoke test run are performed first; only
# after all post-smoke verification checks pass will the unit be
# enabled for continuous operation.
#
# Install procedure (BOT-002):
#   1. Copy this template to your user systemd directory:
#        cp systemd/smartbot-runner.service.template \
#           ~/.config/systemd/user/smartbot-runner.service
#   2. systemctl --user daemon-reload
#   3. systemctl --user start --no-block smartbot-runner.service
#      (--no-block returns immediately; the smoke test observes the
#      journal for at least a few loop iterations)
#   4. Observe via:
#        journalctl --user -u smartbot-runner.service -f
#        systemctl --user status smartbot-runner.service
#   5. After smoke verification passes, enable for continuous:
#        systemctl --user enable smartbot-runner.service
#
# ─────────────────────────────────────────────────────────────────────────
# SAFETY PROPERTIES (designed for, not enforced at the unit level alone)
#
# 1. Loop-independent persistent process.
#    ExecStart runs `main.py --continuous` which acquires the
#    /tmp/trading_bot.lock single-instance guard and then calls
#    SmartTradingBot.run_continuous_loop() with the persistent
#    settings (loop_delay_seconds) from the database. The bot is
#    designed to loop indefinitely; the unit restarts on exit.
#
# 2. Restart=always + RestartSec=30.
#    Restart=always keeps the bot running across transient failures.
#    RestartSec=30 prevents thrashing if the bot crashes in a tight
#    loop (June 28 historical crash loops had 6-second per-iteration
#    durations; 30s restart prevents amplifying those).
#
# 3. WantedBy=default.target.
#    Combined with `systemctl --user enable`, this ensures the
#    runner starts after user session boot. The root user has
#    Linger=yes (verified in this repo's trading-dashboard.service
#    setup on 2026-09-10) so the runner survives logout.
#
# 4. Journald logging.
#    StandardOutput=journal / StandardError=journal make every bot
#    log line available via journalctl --user -u smartbot-runner.
#    The bot's `logging.info(...)` calls (e.g. "Effective strategy
#    settings", "Smart Trading Bot initialized") will appear there.
#    A separate log file at smartbot-runner.log is kept as a
#    file-system fallback in case journald is unavailable.
#
# 5. Single-instance protection.
#    The bot itself uses /tmp/trading_bot.lock (main.py lines 9-39).
#    A second invocation will exit cleanly. Combined with
#    Restart=always, this means at most ONE bot process is ever
#    running per host, even after restart.
#
# 6. Explicit paper-only guard (the SAFETY BOUNDARY).
#    Environment=ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
#    is hard-coded in the unit so a .env edit cannot accidentally
#    promote the bot to live trading. The bot's SmartTradingBot
#    __init__ also constructs TradingClient with paper=True
#    (src/core/smart_bot.py:101) — a defense-in-depth second guard.
#
# 7. Fail closed.
#    RestartPreventExitStatus=78 means systemd will NOT restart
#    the unit when it exits with code 78 (a code-driven intentional
#    stop signal). Combined with StartLimitBurst=5 over
#    StartLimitIntervalSec=300, a tight crash loop is bounded at
#    5 restarts per 5 minutes; if exceeded, the unit fails and
#    must be re-armed manually. This prevents zombie-runner states
#    where a crash-loop amplifies damage.
#
# 8. No live brokerage client.
#    src/brokerage/ contains only base.py + mock.py at the time
#    of BOT-001 (verified 2026-09-10). Any future commit that adds
#    a live Alpaca client must be paired with a corresponding
#    guard in this unit, otherwise the conftest live-mode guard
#    blocks test collection but production is still exposed.
#
# 9. No live endpoint configuration.
#    All API URLs come from ALPACA_BASE_URL (paper URL above) or
#    from .env. The runner does NOT read or accept any other
#    live-mode endpoint. Verified by reading src/core/smart_bot.py
#    and src/database/sqlite_db.py.
# ─────────────────────────────────────────────────────────────────────────
# BOT-002 UPDATES
#
# A. ExecStart now targets `main.py --continuous` (was
#    `scripts/run_continuous.py` in the BOT-001 design). `main.py`
#    owns the /tmp/trading_bot.lock single-instance guard so manual
#    and systemd invocations are mutually exclusive.
#
# B. The BOT-002 paper-only fail-closed guard is enforced in
#    `SmartTradingBot.__init__` (src/core/smart_bot.py) BEFORE
#    TradingClient construction. The guard requires:
#      - TRADING_BOT_PAPER_ONLY == "1"  (hard fail if not)
#      - ALPACA_BASE_URL matches the approved paper endpoint
#        (hard fail if live or unrecognized)
#      - ALPACA_API_KEY starts with "PK"  (hard fail if "AK" prefix)
#    The systemd unit sets TRADING_BOT_PAPER_ONLY=1 and
#    ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2 explicitly
#    so a .env edit cannot accidentally promote the bot.
#
# C. `scripts/run_continuous.py` is preserved for manual smoke testing
#    and now also acquires /tmp/trading_bot.lock. It defaults
#    `loop_delay=None` so the schema-backed value is used.
#
# ─────────────────────────────────────────────────────────────────────────
# DESIGN (NOT enabled at install time — see header)

[Unit]
Description=SmartBot Continuous Paper-Only Trading Runner (BOT-002)
Documentation=file:%h/.local/share/trading-bot/smartbot-runner.README.md
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
WorkingDirectory=/root/.openclaw/workspace/trading-bot

# Fail-closed: if startup fails (missing creds, DB unavailable), do not
# keep restarting indefinitely. Surface the failure to journalctl.
# This is a [Service] key (not [Unit]); the previous BOT-001 template
# placed it under [Unit] which generated "Unknown key name" warnings.
RestartPreventExitStatus=78

# Hard-coded paper URL (guard #6). The .env file is consulted by dotenv
# inside main.py, but THIS environment variable overrides it because the
# bot reads os.getenv("ALPACA_BASE_URL") and the unit env wins over
# .env on Linux systemd. If a future commit adds a way to bypass this
# guard, the conftest live-mode blocks must also be updated.
Environment=ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
Environment=TRADING_BOT_PAPER_ONLY=1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONHASHSEED=random
Environment=HOME=/root
Environment=TMPDIR=/tmp
Environment=PATH=/usr/bin:/root/.local/bin:/root/bin:/usr/local/bin:/bin

# Single-instance lock is implemented inside main.py (lock file at
# /tmp/trading_bot.lock). A second start will fail fast, which is
# fine: Restart=always handles the single-instance case correctly.
ExecStart=/root/.openclaw/workspace/trading-bot/.venv/bin/python \
    -u \
    /root/.openclaw/workspace/trading-bot/main.py --continuous

# Loop-independent persistence (property #1).
Restart=always
RestartSec=30
SuccessExitStatus=0 143

# Journald logging (property #4). StandardOutput keeps every bot
# log line queryable via journalctl --user -u smartbot-runner.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=smartbot-runner

# Bounded start timeout. The bot may need 30-60s to initialize
# (RS ranking, AI provider handshake). 90s is generous.
TimeoutStartSec=90
# Bound shutdown. SIGTERM (exit 143) is normal stop.
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=default.target
