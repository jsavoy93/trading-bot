# GAPFADE-MIDCAP-PAPER — after-close pass timer (16:10 America/New_York).
# USER unit TEMPLATE: not installed/enabled/started by anything in this repo.
[Unit]
Description=GAPFADE midcap paper trial — after-close pass (16:10 America/New_York)

[Timer]
OnCalendar=Mon..Fri 16:10 America/New_York
Persistent=false
AccuracySec=1min
Unit=gapfade-midcap-after-close.service

[Install]
WantedBy=timers.target
